{
  "lexicon": 1,
  "id": "app.manasphere.container",
  "defs": {
    "main": {
      "type": "record",
      "description": "A named physical place cards live: a binder, a box, a deck box.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 640,
            "maxGraphemes": 64,
            "description": "Display name. Cannot be empty."
          },
          "kind": {
            "type": "string",
            "maxLength": 32,
            "knownValues": ["binder", "box", "deckBox", "shelf", "other"],
            "description": "What sort of place this is. Cosmetic."
          },
          "note": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
